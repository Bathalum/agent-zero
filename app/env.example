# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here-change-in-production
FLASK_DEBUG=False
PORT=5000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# WARNING: Service role key has admin privileges - keep it secret!
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Agent Zero Configuration
# For Docker: Use service name (e.g., http://agent-zero-local:80)
# For local development: Use localhost (e.g., http://localhost:8080)
# For production: Use your production URL
AGENT_ZERO_URL=http://localhost:8080
AGENT_ZERO_REQUEST_TIMEOUT=10
