{
  "name": "@argent/agui-client",
  "version": "1.0.0",
  "description": "Client library for AG-UI protocol integration with Argent",
  "main": "dist/client.js",
  "module": "dist/client.esm.js",
  "types": "dist/client.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "rollup -c --environment BUILD:esm",
    "build:cjs": "rollup -c --environment BUILD:cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agui",
    "argent",
    "agent",
    "websocket",
    "sse",
    "realtime"
  ],
  "author": "Argent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/argent/agent-zero"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rollup": "^4.6.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}

