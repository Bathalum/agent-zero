{
  "n8n_base_url": "https://your-n8n-instance.app.n8n.cloud",
  "workflows": {
    "email_workflow": {
      "webhook_path": "/webhook/your-webhook-id",
      "description": "Send automated emails",
      "parameters": [
        "recipient",
        "template",
        "data"
      ]
    },
    "slack_message": {
      "webhook_path": "/webhook/your-webhook-uuid-here",
      "description": "Send Slack Message to a specific channel",
      "parameters": [
        "Message"
      ]
    }
  }
}

